# Listen address. Transcripts contain code, prompts and secrets: keep 127.0.0.1
# unless you know who can reach the port.
HOST=127.0.0.1
PORT=8767
# Where the harnesses keep their data (the defaults are their standard locations).
# CLAUDE_DIR=/home/me/.claude
# CURSOR_DIR=/home/me/.cursor
# CURSOR_LOGS_DIR=/home/me/.cursor-server/data/logs
# CODEX_DIR=/home/me/.codex
# PI_DIR=/home/me/.pi
# OPENCODE_DB=/home/me/.local/share/opencode/opencode.db
# KILO_DB=/home/me/.local/share/kilo/kilo.db
